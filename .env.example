# Подключение к БД (SQLite по умолчанию)
DATABASE_URL=sqlite:///data/app.db

# Пароль админ-панели
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD

# Секретный ключ подписи сессий (сгенерируйте свой для прода)
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET_KEY
COOKIE_SECURE=true  # true только при HTTPS
CORS_ORIGINS=  # например https://erp.example.com

# Google Sheets (фаза 3)
GOOGLE_SA_FILE=gen-lang-client-0103225655-395c3c364797.json
GOOGLE_SPREADSHEET_ID=
SYNC_ENABLED=false
SYNC_SCHEDULE="0 * * * *"

# Резервное копирование (фаза 4)
BACKUP_DIR=backups
BACKUP_KEEP=7
BACKUP_SCHEDULE=0 3 * * *
