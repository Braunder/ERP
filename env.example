# Подключение к БД (SQLite по умолчанию)
DATABASE_URL=sqlite:///data/app.db

# Пароль админ-панели
ADMIN_PASSWORD=admin

# Секретный ключ подписи сессий (сгенерируйте свой для прода)
SECRET_KEY=change-me-in-production

# Google Sheets (фаза 3)
# Локально: путь к JSON-файлу сервисного аккаунта на диске.
GOOGLE_SA_FILE=gen-lang-client-0103225655-395c3c364797.json
# На Railway/другом PaaS: вставьте сюда содержимое того же JSON-файла
# целиком одной строкой вместо GOOGLE_SA_FILE (файл в контейнере недоступен).
# Если задано — имеет приоритет над GOOGLE_SA_FILE.
GOOGLE_SA_JSON=
GOOGLE_SPREADSHEET_ID=
SYNC_ENABLED=false
SYNC_SCHEDULE="0 2 * * *"

# Резервное копирование (фаза 4)
BACKUP_DIR=backups
BACKUP_KEEP=7
BACKUP_SCHEDULE=0 3 * * *
